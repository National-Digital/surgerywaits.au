{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "surgerywaits",
  "main": "index.ts",
  "compatibility_date": "2026-11-06",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../site/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
  },
  "env": {
    // A second Worker with the same code. The Worker marks every host but the site's own noindex.
    "staging": {
      "name": "surgerywaits-staging",
      "workers_dev": false,
      "preview_urls": false,
    },
  },
}
