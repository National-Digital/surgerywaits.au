{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surgerywaits.au/contract/tool-figures.schema.json",
  "title": "Compare tool figures",
  "description": "/tool/figures.json: every procedure's figure rows, keyed by procedure slug, which the compare tool loads when its surgery box is first used. A value is its number when published, and -1 minus the place of its reason in the index's reasons when it is not. A figure row is [hospital's place in the index's hospitals, stamp index, median wait, volume, rank or null, median history or null], and the history is the first year followed by one value for each later year, with null for a year the hospital did not report. pairs lists the places in the index's hospitals of the hospitals that have a page for the procedure.",
  "type": "object",
  "additionalProperties": false,
  "required": ["procedures"],
  "properties": {
    "procedures": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/slug"
      },
      "additionalProperties": {
        "$ref": "#/$defs/procedure"
      }
    }
  },
  "$defs": {
    "value": {
      "type": "number",
      "minimum": -1000000
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairs", "rows", "slug", "stamps"],
      "properties": {
        "slug": {
          "$ref": "common.schema.json#/$defs/slug"
        },
        "stamps": {
          "description": "Each reference period with the date its figures were released.",
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "common.schema.json#/$defs/period"
              },
              {
                "$ref": "common.schema.json#/$defs/date"
              }
            ],
            "items": false,
            "minItems": 2
          }
        },
        "pairs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "$ref": "#/$defs/value"
              },
              {
                "$ref": "#/$defs/value"
              },
              {
                "type": ["integer", "null"],
                "minimum": 1
              },
              {
                "type": ["array", "null"],
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/value"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "minItems": 2
              }
            ],
            "items": false,
            "minItems": 6
          }
        }
      }
    }
  }
}
