{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surgerywaits.au/contract/tool-procedure.schema.json",
  "title": "Compare tool procedure figures",
  "description": "/tool/procedures/<slug>.json: one procedure's figure rows. A value is its number when published, and -1 minus the place of its reason in the index's reasons when it is not. A figure row is [hospital index, stamp index, median wait, volume, rank or null, median history or null], and the history is the first year followed by one value for each later year, with null for a year the hospital did not report. pairs lists the hospital indexes that have a page for this procedure.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pairs", "rows", "slug", "stamps"],
  "properties": {
    "slug": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "stamps": {
      "description": "Each reference period with the date its figures were released.",
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "$ref": "common.schema.json#/$defs/period"
          },
          {
            "$ref": "common.schema.json#/$defs/date"
          }
        ],
        "items": false,
        "minItems": 2
      }
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "$ref": "#/$defs/value"
          },
          {
            "$ref": "#/$defs/value"
          },
          {
            "type": ["integer", "null"],
            "minimum": 1
          },
          {
            "type": ["array", "null"],
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/value"
                },
                {
                  "type": "null"
                }
              ]
            },
            "minItems": 2
          }
        ],
        "items": false,
        "minItems": 6
      }
    }
  },
  "$defs": {
    "value": {
      "type": "number",
      "minimum": -1000000
    }
  }
}
