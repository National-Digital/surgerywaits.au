{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surgerywaits.au/contract/hospital.schema.json",
  "title": "Hospital page",
  "description": "hospitals/<slug>.json: one public hospital, its newest figures for each category and its nearest open hospitals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "slug",
    "name",
    "alternative_names",
    "state",
    "closed",
    "network",
    "location",
    "scope",
    "surgeries",
    "nearby",
    "sources"
  ],
  "properties": {
    "code": {
      "$ref": "common.schema.json#/$defs/code"
    },
    "slug": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "alternative_names": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/text"
      }
    },
    "state": {
      "$ref": "common.schema.json#/$defs/state"
    },
    "closed": {
      "type": "boolean"
    },
    "network": {
      "description": "The publisher's own network mapping; null where it gave none.",
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/network"
        },
        {
          "type": "null"
        }
      ]
    },
    "location": {
      "description": "Null where the publisher gave no coordinates; none is ever guessed.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": {
              "$ref": "common.schema.json#/$defs/latitude"
            },
            "longitude": {
              "$ref": "common.schema.json#/$defs/longitude"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "$ref": "common.schema.json#/$defs/scope"
    },
    "surgeries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "slug", "name", "stale", "measures"],
        "properties": {
          "kind": {
            "$ref": "common.schema.json#/$defs/kind"
          },
          "slug": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "measures": {
            "$ref": "common.schema.json#/$defs/measures"
          },
          "stale": {
            "description": "True when the hospital's newest figures are from an earlier period than the table's newest; the site must not present them as current.",
            "type": "boolean"
          }
        }
      }
    },
    "nearby": {
      "description": "Null for a hospital with no coordinates.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["radius_km", "hospitals"],
          "properties": {
            "radius_km": {
              "type": "integer",
              "minimum": 1
            },
            "hospitals": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "name", "slug", "distance_km"],
                "properties": {
                  "code": {
                    "$ref": "common.schema.json#/$defs/code"
                  },
                  "name": {
                    "$ref": "common.schema.json#/$defs/text"
                  },
                  "slug": {
                    "description": "Null where the hospital has no figures and so no page.",
                    "oneOf": [
                      {
                        "$ref": "common.schema.json#/$defs/slug"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "distance_km": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    }
  }
}
