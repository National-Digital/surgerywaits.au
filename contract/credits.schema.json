{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surgerywaits.au/contract/credits.schema.json",
  "title": "Credits",
  "description": "credits.json: the attribution and citation publicdata.au publishes for each source version the build read.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "manifest.schema.json#/$defs/entry" }
    }
  }
}
