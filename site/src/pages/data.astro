---
import ArticlePage from '../components/ArticlePage.astro';
import DataPassport from '../components/DataPassport.astro';
import { getDataPage, getSite, label } from '../lib/content';
import { readCredits } from '../lib/credits';
import { sourceDataset } from '../lib/json-ld';
import { formatCount } from '../lib/format';
import { homeCounts } from '../lib/home-page';
import { surgeryStamp } from '../lib/index-pages';
import { DATA_PATH, dataFacts, fillSections, fillText } from '../lib/article-pages';
import { fill } from '../lib/slots';

const t = getDataPage();
const facts = dataFacts();
const counts = homeCounts();
const credits = readCredits();
---

<ArticlePage
  title={fill(t.title, { site: getSite().name })}
  description={t.description}
  path={DATA_PATH}
  crumbHome={t.crumb_home}
  crumb={t.crumb}
  heading={fillText(t.heading, facts)}
  intro={[
    fillText(t.lede, facts),
    fill(t.stamp, surgeryStamp()),
    fill(t.counts, {
      hospitals: formatCount(counts.hospitals),
      surgeries: formatCount(counts.surgeries),
    }),
  ]}
  sections={fillSections(t.sections, facts)}
  after={fillSections(t.after, facts)}
  jsonLd={credits.map((credit) =>
    sourceDataset(
      credit,
      fill(label('dataset_source_description'), {
        title: credit.title,
        publisher: credit.publisher.name,
        version: credit.version,
      }),
    ),
  )}
>
  <DataPassport sources={credits.map((credit) => credit.slug)} />
</ArticlePage>
