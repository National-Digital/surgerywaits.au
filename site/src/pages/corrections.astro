---
import ArticlePage from '../components/ArticlePage.astro';
import PlainTable from '../components/PlainTable.astro';
import Prose from '../components/Prose.astro';
import { getCorrections, getSite } from '../lib/content';
import {
  CORRECTIONS_PATH,
  correctionRows,
  fillSections,
  fillText,
  policyFacts,
  updatedLine,
} from '../lib/article-pages';
import { fill } from '../lib/slots';

const t = getCorrections();
const facts = policyFacts();
const { log } = t;
---

<ArticlePage
  title={fill(t.title, { site: getSite().name })}
  description={t.description}
  path={CORRECTIONS_PATH}
  crumbHome={t.crumb_home}
  crumb={t.crumb}
  heading={fillText(t.heading, facts)}
  intro={[fillText(t.lede, facts), updatedLine(t)]}
  sections={fillSections(t.sections, facts)}
>
  <section id="log" aria-labelledby="log-heading">
    <h2 id="log-heading">{log.heading}</h2>
    {log.entries.length === 0 ? (
      <Prose paragraphs={[log.empty]} />
    ) : (
      <PlainTable
        id="log"
        caption={log.caption}
        stamp={updatedLine(t)}
        rowHeading={log.row_heading}
        headings={log.headings}
        rows={correctionRows(log)}
      />
    )}
  </section>
</ArticlePage>
