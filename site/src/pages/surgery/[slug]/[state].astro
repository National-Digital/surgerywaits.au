---
import SurgeryState from '../../../components/SurgeryState.astro';
import { KINDS, stateRoutes } from '../../../lib/surgery-page';

interface Props {
  slug: string;
  state: string;
}

export function getStaticPaths(): { params: { slug: string; state: string }; props: Props }[] {
  return stateRoutes(KINDS.procedure);
}

const { slug, state } = Astro.props;
---

<SurgeryState kind={KINDS.procedure} urlSlug={slug} {state} />
