---
import ArticlePage from '../components/ArticlePage.astro';
import { getTerms, getSite } from '../lib/content';
import { TERMS_PATH, fillSections, fillText, policyFacts, updatedLine } from '../lib/article-pages';
import { fill } from '../lib/slots';

const t = getTerms();
const facts = policyFacts();
---

<ArticlePage
  title={fill(t.title, { site: getSite().name })}
  description={t.description}
  path={TERMS_PATH}
  crumbHome={t.crumb_home}
  crumb={t.crumb}
  heading={fillText(t.heading, facts)}
  intro={[fillText(t.lede, facts), updatedLine(t)]}
  sections={fillSections(t.sections, facts)}
/>
