---
// The global sheet is first so its layer order precedes any component layer in the bundle.
import '../styles/global.css';
import CompareBar from '../components/CompareBar.astro';
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import SkipLink from '../components/SkipLink.astro';

interface Props {
  title: string;
  noindex?: boolean;
  compactFooter?: boolean;
  compareBar?: boolean;
}

const { title, noindex = false, compactFooter = false, compareBar = true } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <SkipLink />
    <Masthead />
    <main id="main" class="o-wrap">
      <slot />
    </main>
    {compareBar && <CompareBar />}
    <Footer compact={compactFooter} />
  </body>
</html>
