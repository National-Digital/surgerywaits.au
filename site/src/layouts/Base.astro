---
// The global sheet is first so its layer order precedes any component layer in the bundle.
import '../styles/global.css';
import CompareBar from '../components/CompareBar.astro';
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import JsonLd from '../components/JsonLd.astro';
import SkipLink from '../components/SkipLink.astro';
import { getSite } from '../lib/content';
import { BEACON_SRC } from '../lib/privacy';
import { breadcrumbList, organization, webPage, website } from '../lib/json-ld';
import type { Crumb, JsonLdNode } from '../lib/json-ld';

interface Props {
  title: string;
  description?: string;
  // The page's own path; the origin comes from the site entity.
  canonicalPath?: string;
  noindex?: boolean;
  compactFooter?: boolean;
  compareBar?: boolean;
  // A page that prints as one sheet leaves the footer off it.
  printFooter?: boolean;
  medical?: boolean | undefined;
  // The @id of the thing the page is about, and the nodes that define it.
  about?: string | undefined;
  // The trail the page shows, so its list and its visible trail come from the same items.
  crumbs?: Crumb[] | undefined;
  jsonLd?: JsonLdNode[] | undefined;
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  compactFooter = false,
  compareBar = true,
  printFooter = true,
  medical,
  about,
  crumbs = [],
  jsonLd = [],
} = Astro.props;
const site = getSite();
const canonical = canonicalPath === undefined ? undefined : new URL(canonicalPath, site.url);
// A page with no canonical address, such as the 404, describes only the publisher and the site.
const graph = [
  organization(site),
  website(site),
  ...(canonicalPath === undefined
    ? []
    : [
        webPage(site, { path: canonicalPath, title, description, medical, about }),
        ...(crumbs.length > 1 ? [breadcrumbList(site, canonicalPath, crumbs)] : []),
      ]),
  ...jsonLd,
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description !== undefined && <meta name="description" content={description} />}
    {canonical !== undefined && <link rel="canonical" href={canonical.href} />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <JsonLd nodes={graph} />
  </head>
  <body>
    <SkipLink />
    <Masthead />
    <main id="main" class="o-wrap">
      <slot />
    </main>
    {compareBar && <CompareBar />}
    <Footer compact={compactFooter} printHidden={!printFooter} />
    <script
      is:inline
      defer
      src={BEACON_SRC}
      data-cf-beacon={JSON.stringify({ token: site.analytics.beacon_token })}
    ></script>
  </body>
</html>
