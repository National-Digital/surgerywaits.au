---
// The global sheet is first so its layer order precedes any component layer in the bundle.
import '../styles/global.css';
import SkipLink from '../components/SkipLink.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <SkipLink />
    <main id="main" class="o-wrap">
      <slot />
    </main>
  </body>
</html>
