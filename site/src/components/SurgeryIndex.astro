---
// Base comes first so its global sheet, and with it the layer order, precedes every component sheet.
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import JumpList from './JumpList.astro';
import LinkList from './LinkList.astro';
import DataPassport from './DataPassport.astro';
import SafetyBlock from './SafetyBlock.astro';
import { getHospitalTemplate, getSite, getSurgeryTemplate } from '../lib/content';
import { formatCount } from '../lib/format';
import { URGENCY_ID, surgeryStamp, urgencyEntries } from '../lib/index-pages';
import { readSurgeryIndexSources } from '../lib/dist';
import { fill } from '../lib/slots';
import { categoryPathOf } from '../lib/urgency-page';
import { SPECIALTY_PATH, SURGERY_PATH, indexGroups, surgeryPath } from '../lib/surgery-page';

const t = getSurgeryTemplate();
const site = getSite().name;
const headings = {
  procedure: { heading: t.index_procedures_heading, intro: t.index_procedures_intro },
  specialty: { heading: t.index_specialties_heading, intro: t.index_specialties_intro },
};
const groups = indexGroups().map((group) => ({ ...group, ...headings[group.kind] }));
const urgency = urgencyEntries(getHospitalTemplate().urgency, categoryPathOf);
const stamp = surgeryStamp();
const jump = [
  { label: t.index_urgency_heading, href: `#${URGENCY_ID}` },
  ...groups.map((group) => ({ label: group.heading, href: `#${group.id}` })),
];
const count = (hospitals: number): string =>
  hospitals === 1
    ? t.index_hospitals_one
    : fill(t.index_hospitals_many, { count: formatCount(hospitals) });
const sources = readSurgeryIndexSources();
const crumbs = [{ label: t.crumb_home, href: '/' }, { label: t.crumb_surgery }];
---

<Base
  {crumbs}
  title={fill(t.index_title, { site })}
  description={t.index_description}
  canonicalPath={SURGERY_PATH}
>
  <div class="o-columns">
    <Breadcrumbs items={crumbs} />
    <h1>{t.index_heading}</h1>
    <p>{t.index_lede}</p>
    <p>{fill(t.index_stamp, stamp)}</p>
    <LinkList links={[{ label: t.index_specialties_link, href: SPECIALTY_PATH }]} />
    <JumpList heading={t.index_jump_heading} label={t.index_jump_label} items={jump} />

    <section aria-labelledby={URGENCY_ID}>
      <h2 id={URGENCY_ID}>{t.index_urgency_heading}</h2>
      <p>{t.index_urgency_intro}</p>
      <ul>
        {urgency.map((entry) => (
          // eslint-disable-next-line @typescript-eslint/no-unsafe-return -- the Astro parser types JSX as error
          <li>
            <a href={entry.href}>{entry.label}</a>
            <p>
              {count(entry.hospitals)}
              {'. '}
              {fill(t.index_period, { period: entry.period })}
            </p>
          </li>
        ))}
      </ul>
    </section>

    {groups.map((group) => (
      // eslint-disable-next-line @typescript-eslint/no-unsafe-return -- the Astro parser types JSX as error
      <section aria-labelledby={group.id}>
        <h2 id={group.id}>{group.heading}</h2>
        <p>{group.intro}</p>
        <ul>
          {group.items.map((entry) => (
            // eslint-disable-next-line @typescript-eslint/no-unsafe-return -- the Astro parser types JSX as error
            <li>
              <a href={surgeryPath(entry.ref)}>{entry.ref.name}</a>
              <p>
                {count(entry.hospitals)}
                {'. '}
                {fill(t.index_period, { period: entry.period })}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section aria-labelledby="exclusion-heading">
      <h2 id="exclusion-heading">{t.exclusion_heading}</h2>
      <p>{t.exclusion}</p>
    </section>

    <SafetyBlock id="surgery-safety-heading" />
    <DataPassport sources={sources} />
  </div>
</Base>
