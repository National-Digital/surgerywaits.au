---
import type { NavLink } from '../lib/links';

interface Props {
  heading: string;
  label: string;
  items: NavLink[];
}

const { heading, label, items } = Astro.props;
---

<nav class="c-jump" aria-label={label}>
  <h2 class="c-jump__heading">{heading}</h2>
  <ul class="c-jump__list">
    {items.map((item) => (
      // eslint-disable-next-line @typescript-eslint/no-unsafe-return -- the Astro parser types JSX as error
      <li>
        <a class="c-jump__link" href={item.href}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  @layer components {
    .c-jump {
      margin-block: var(--space-5);
    }

    .c-jump__heading {
      margin-block: 0 var(--space-2);
      font-size: 1.125rem;
    }

    .c-jump__list {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--space-4);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .c-jump__link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: var(--target);
      min-height: var(--target);
    }
  }
</style>
