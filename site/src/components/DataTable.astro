---
import { label } from '../lib/content';
import { formatFigureParts, formatRank, formatStamp, isPublished } from '../lib/format';
import type { Role } from '../lib/format';
import { assertTable, pairCells, tableIds } from '../lib/table';
import type { Span, TableRow } from '../lib/table';

interface Props {
  id: string;
  caption: string;
  rowHeading: string;
  columns: { heading: string; role: Role }[];
  rows: TableRow[];
  // A table that spans periods states its own range, since its rows cannot share one period.
  span?: Span;
}

const { id, caption, rowHeading, columns, rows, span } = Astro.props;
const ids = tableIds(id);
// A table with no period or release, with current rows that disagree, or with a rank on a stale or withheld cell throws here.
const stamp = assertTable(columns, rows, span);
---

<p class="c-table__hint" id={ids.hint}>
  {label('table_scroll_hint')}
</p>
<div class="o-table-scroll" role="region" aria-labelledby={ids.caption} tabindex="0">
  <table class="c-table">
    <caption class="c-table__caption" id={ids.caption}>
      {caption}
      <small class="c-table__stamp">{stamp}</small>
    </caption>
    <thead>
      <tr>
        <th class="c-table__head c-table__head--row" scope="col">
          {rowHeading}
        </th>
        {columns.map((column) => (
          // eslint-disable-next-line @typescript-eslint/no-unsafe-return -- the Astro parser types JSX as error
          <th class="c-table__head" scope="col">
            {column.heading}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        // eslint-disable-next-line @typescript-eslint/no-unsafe-return -- the Astro parser types JSX as error
        <tr class:list={['c-table__row', { 'c-table__row--earlier': row.stale === true }]}>
          <th class="c-table__name" scope="row">
            {row.href !== undefined ? <a href={row.href}>{row.name}</a> : row.name}
            {row.stale === true && (
              <small class="c-table__marker">{label('table_earlier_marker')}</small>
            )}
          </th>
          {pairCells(columns, row).map(({ role, cell }) => {
            const parts = formatFigureParts(role, cell.figure);
            // eslint-disable-next-line @typescript-eslint/no-unsafe-return -- the Astro parser types JSX as error
            return (
              <td class="c-table__cell">
                <span
                  class:list={['c-table__value', { 'is-not-published': !isPublished(cell.figure) }]}
                >
                  {parts.amount}
                  {parts.unit !== null && (
                    <>
                      {' '}
                      <span class="c-table__unit">{parts.unit}</span>
                    </>
                  )}
                </span>
                {row.stale === true && (
                  <small class="c-table__period">{formatStamp(cell.figure)}</small>
                )}
                {cell.rank && (
                  <small class="c-table__rank">
                    {label('rank_caption')} {formatRank(cell.rank.position, cell.rank.of)}
                  </small>
                )}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  @layer components {
    .c-table {
      width: 100%;
      border-collapse: collapse;
      font-variant-numeric: tabular-nums;
      font-size: var(--fs-small);
    }

    .c-table__caption {
      padding: var(--space-3) var(--space-4) 0;
      text-align: start;
      color: var(--ink-2);
    }

    .c-table__stamp {
      display: block;
      margin-block-start: var(--space-1);
      font-size: var(--fs-small);
      color: var(--muted);
    }

    .c-table__hint {
      margin: 0 0 var(--space-2);
      font-size: var(--fs-small);
      color: var(--muted);
    }

    .c-table__head,
    .c-table__name,
    .c-table__cell {
      padding: var(--space-3) var(--space-4);
      border-block-end: 1px solid var(--hairline);
      text-align: end;
      vertical-align: top;
    }

    .c-table__head {
      background: var(--card-2);
      font-size: var(--fs-small);
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--muted);
    }

    .c-table__head--row,
    .c-table__name {
      position: sticky;
      inset-inline-start: 0;
      min-width: 12rem;
      text-align: start;
    }

    .c-table__name {
      background: var(--card);
      font-weight: 700;
      color: var(--ink);
    }

    .c-table__name a {
      display: inline-block;
      min-height: var(--target);
      line-height: var(--target);
    }

    .c-table__row:last-child > * {
      border-block-end: 0;
    }

    .c-table__marker,
    .c-table__period,
    .c-table__rank {
      display: block;
      margin-block-start: var(--space-1);
      font-size: var(--fs-small);
      font-weight: 400;
      color: var(--ink-2);
    }

    .c-table__marker {
      font-weight: 700;
      color: var(--ink);
    }

    .c-table__row--earlier .c-table__name {
      border-inline-start: var(--space-1) solid var(--muted);
    }

    .c-table__value {
      font: var(--fs-figure-sm) / 1.3 var(--serif);
    }

    .c-table__value.is-not-published {
      font: italic 400 var(--fs-small) / var(--lh-body) var(--sans);
      color: var(--ink-2);
    }

    .c-table__unit {
      font-size: var(--fs-small);
    }
  }
</style>
