---
import type { NavLink } from '../lib/links';

interface Props {
  links: NavLink[];
}

const { links } = Astro.props;
---

<ul class="c-link-list">
  {links.map(({ label: text, href }) => (
    // eslint-disable-next-line @typescript-eslint/no-unsafe-return -- the Astro parser types JSX as error
    <li>
      <a class="c-link-list__link" {href}>
        {text}
      </a>
    </li>
  ))}
</ul>

<style>
  @layer components {
    .c-link-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--space-5);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .c-link-list__link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: var(--target);
      min-height: var(--target);
      text-decoration: none;
    }

    .c-link-list__link:hover,
    .c-link-list__link:focus-visible {
      text-decoration: underline;
    }
  }
</style>
