---
// Base comes first so its global sheet, and with it the layer order, precedes every component sheet.
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DataPassport from '../components/DataPassport.astro';
import DataTable from '../components/DataTable.astro';
import TrendChart from '../components/TrendChart.astro';
import WaitBars from '../components/WaitBars.astro';
import Figure from '../components/Figure.astro';
import SafetyBlock from '../components/SafetyBlock.astro';
import StatTile from '../components/StatTile.astro';
import StatTiles from '../components/StatTiles.astro';
import { getNavigation, label } from '../lib/content';
import type { QueenslandColumn } from '../lib/format';
import {
  sampleCharts,
  sampleFigures,
  samplePage,
  sampleQueensland,
  sampleTable,
  sampleTiles,
  sampleWaitBars,
  withheldFigures,
} from './preview';

const roleLabel = {
  median_wait: label('role_median_wait'),
  volume: label('role_volume'),
  long_wait: label('role_long_wait'),
  on_time: label('role_on_time'),
};
const queenslandLabel: Partial<Record<QueenslandColumn, string>> = {
  treated: label('qld_treated'),
  percent_treated_in_time: label('qld_percent_treated_in_time'),
  percent_change_treated_on_prior_year: label('qld_percent_change_treated_on_prior_year'),
};

const figures = sampleFigures();
const tiles = sampleTiles();
const queensland = sampleQueensland();
const table = sampleTable();
const page = samplePage();
const charts = sampleCharts({
  hospital: label('preview_chart_this'),
  national: label('preview_chart_national'),
});
const bars = sampleWaitBars();
const [first] = figures;
const withheld = first
  ? withheldFigures({ period: first.figure.period, release: first.figure.release })
  : [];
---

<Base title={label('title_primitives')} noindex>
  <h1>{label('preview_heading')}</h1>
  <p>{label('preview_intro')}</p>

  <h2>{label('preview_figures')}</h2>
  <dl>
    {figures.map((sample) => (
      // eslint-disable-next-line @typescript-eslint/no-unsafe-return -- the Astro parser types JSX as error
      <>
        <dt>{roleLabel[sample.role]}</dt>
        <dd>
          <Figure role={sample.role} figure={sample.figure} />
          <p>{sample.hospital}</p>
        </dd>
      </>
    ))}
  </dl>

  <h2>{label('preview_tiles')}</h2>
  <StatTiles>
    {tiles.map((tile) => (
      // eslint-disable-next-line @typescript-eslint/no-unsafe-return -- the Astro parser types JSX as error
      <StatTile
        heading={roleLabel[tile.role]}
        role={tile.role}
        figure={tile.figure}
        stale={tile.stale}
        {...(tile.rank ? { rank: tile.rank } : {})}
        change={tile.change ?? null}
      />
    ))}
  </StatTiles>

  <h2>{label('preview_withheld')}</h2>
  <dl>
    {withheld.map((figure) => (
      // eslint-disable-next-line @typescript-eslint/no-unsafe-return -- the Astro parser types JSX as error
      <>
        <dt>{roleLabel.median_wait}</dt>
        <dd>
          <Figure role="median_wait" {figure} />
        </dd>
      </>
    ))}
  </dl>

  <h2>{label('preview_queensland')}</h2>
  <dl>
    {queensland.map((sample) => (
      // eslint-disable-next-line @typescript-eslint/no-unsafe-return -- the Astro parser types JSX as error
      <>
        <dt>{queenslandLabel[sample.column] ?? sample.facility}</dt>
        <dd>
          <Figure column={sample.column} figure={sample.figure} />
          <p>{sample.facility}</p>
        </dd>
      </>
    ))}
  </dl>

  <h2>{label('preview_table')}</h2>
  <DataTable
    id="preview-table"
    caption={label('preview_table_caption')}
    rowHeading={label('preview_table_row_heading')}
    columns={table.roles.map((role) => ({ heading: roleLabel[role], role }))}
    rows={table.rows}
  />

  <h2>{label('preview_breadcrumbs')}</h2>
  <Breadcrumbs
    items={[
      { label: label('title_home'), href: '/' },
      { label: label('preview_crumb_hospital'), href: getNavigation().site[0]?.href },
      { label: page.name },
    ]}
  />

  <h2>{label('preview_safety')}</h2>
  <SafetyBlock id="preview-safety-heading" />

  <h2>{label('preview_passport')}</h2>
  <DataPassport sources={page.sources} />

  <h2>{label('preview_chart')}</h2>
  <TrendChart
    id="preview-chart"
    name={label('preview_chart_name')}
    caption={label('preview_chart_caption')}
    role="median_wait"
    series={charts.plain.series}
  />

  <h2>{label('preview_chart_gap')}</h2>
  <TrendChart
    id="preview-chart-gaps"
    name={label('preview_chart_name')}
    caption={label('preview_chart_table_caption')}
    role="median_wait"
    series={charts.gaps.series}
  />

  <h2>{label('preview_wait_bars')}</h2>
  <WaitBars
    id="preview-bars"
    caption={label('preview_wait_bars_caption')}
    role="median_wait"
    {bars}
  />
</Base>
