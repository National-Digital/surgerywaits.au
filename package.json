{
  "name": "surgerywaits",
  "private": true,
  "type": "module",
  "description": "Public hospital planned-surgery waiting times in Australia.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "^26.13.0"
  },
  "workspaces": [
    "site"
  ],
  "scripts": {
    "lint": "npm run --silent sync -w site && eslint --max-warnings 0 .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run --silent check -w site && tsc --noEmit -p worker && tsc --noEmit -p scripts && tsc --noEmit -p eslint",
    "knip": "knip",
    "test": "vitest run",
    "build": "npm run --silent build -w site",
    "build:preview": "npm run --silent build:preview -w site",
    "worker:dry-run": "wrangler deploy --dry-run --env=\"\" --config worker/wrangler.jsonc --outdir",
    "worker:types": "wrangler types --include-runtime=false --config worker/wrangler.jsonc worker/worker-configuration.d.ts",
    "worker:types:check": "wrangler types --check --include-runtime=false --config worker/wrangler.jsonc worker/worker-configuration.d.ts",
    "a11y": "node scripts/a11y.ts",
    "html": "node scripts/html.ts",
    "links": "node scripts/links.ts",
    "weight": "node scripts/weight.ts",
    "jsonld:parity": "node scripts/jsonld-parity.ts check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/css": "2.0.1",
    "@eslint/css-tree": "4.1.2",
    "@eslint/js": "10.0.1",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/node": "26.6.6",
    "astro-eslint-parser": "3.2.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "jsonc-parser": "3.3.1",
    "knip": "6.44.1",
    "parse5": "8.1.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "vnu-jar": "26.11.4",
    "wrangler": "4.158.0"
  }
}
